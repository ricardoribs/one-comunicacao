PORT=3000
NODE_ENV=development
TRUST_PROXY=1
DATABASE_URL=postgresql://postgres:SUA_SENHA_URL_ENCODED@localhost:5432/one_comunicacao
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL_REQUIRED=false
DATABASE_SSL_CA_FILE=
DATABASE_SSL_CA_PEM=
VERIFY_DATABASE_URL=
JWT_SECRET=
# gere com: openssl rand -hex 64
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
PASSWORD_RESET_EXPIRES_MINUTES=60
EMAIL_VERIFICATION_EXPIRES_HOURS=24
BCRYPT_ROUNDS=12
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MINUTES=15
REFRESH_COOKIE_NAME=one_refresh_token
UPLOAD_MAX_FILE_SIZE_MB=10
DB_POOL_MAX=8
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
UPLOAD_PROVIDER=local
UPLOAD_REQUIRE_MALWARE_SCAN=false
MALWARE_SCAN_PROVIDER=none
# Backlog: habilitar ClamAV somente quando houver scanner real disponivel.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
PAYMENT_PROVIDER=manual
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=no-reply@one.local
SENTRY_DSN=
SENTRY_REQUIRED=false
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
APP_BASE_URL=http://localhost:3000
GEO_LOOKUP_ENABLED=true
GEO_LOOKUP_TIMEOUT_MS=1200
GEO_LOOKUP_CACHE_TTL_MS=21600000
GEO_LOOKUP_URL_TEMPLATE=https://ipwho.is/{ip}?fields=success,country_code,country,region,city
CORS_ORIGINS=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_REQUIRE_PRIVATE_UPLOAD=false
# Local: deixe vazio para nao exigir MFA sem MFA_ENCRYPTION_KEY.
# Em producao/Render, o default do app e admin,gestor,comercial quando omitido.
MFA_REQUIRED_ROLES=
MFA_ENCRYPTION_KEY=
FINANCIAL_ENCRYPTION_KEY=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
MFA_CHALLENGE_EXPIRES_MINUTES=5
MFA_ISSUER=ONE Comunicacao
# Backlog: configurar webhook real quando o canal de alertas existir.
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_TIMEOUT_MS=5000
SMOKE_EMAIL=
SMOKE_PASSWORD=
MAINTENANCE_MODE=false

# Google Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar-integrations/google/callback
GOOGLE_CALENDAR_SYNC_INTERVAL_MS=1800000
